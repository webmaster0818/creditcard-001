---
import BaseLayout from './BaseLayout.astro';
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';

interface Props {
  article: CollectionEntry<'articles'>;
}

const { article } = Astro.props;
const { title, description, pubDate, updatedDate, author, tags, heroImage } = article.data;

const formattedPubDate = pubDate.toLocaleDateString('ja-JP', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const formattedUpdatedDate = updatedDate?.toLocaleDateString('ja-JP', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

// 関連記事を取得（同じタグを持つ記事）
const allArticles = await getCollection('articles');
const relatedArticles = allArticles
  .filter(a => a.id !== article.id && a.data.tags.some(tag => tags.includes(tag)))
  .slice(0, 4);

// タグから主要カテゴリを判定（優先度順）
const categoryMap: { [key: string]: { name: string; slug: string; keywords: string[] } } = {
  'marriott-amex': { 
    name: 'マリオットAMEX', 
    slug: 'marriott-amex',
    keywords: ['マリオットAMEX', 'マリオットボンヴォイ', 'SPG', 'Marriott']
  },
  'jal-mile': { 
    name: 'JALマイル', 
    slug: 'jal-mile',
    keywords: ['JALマイル', 'JAL', 'Japan Airlines']
  },
  'ana-mile': { 
    name: 'ANAマイル', 
    slug: 'ana-mile',
    keywords: ['ANAマイル', 'ANA', 'All Nippon Airways']
  },
  'hotel-benefits': { 
    name: 'ホテル特典', 
    slug: 'hotel-benefits',
    keywords: ['ホテル特典', 'ホテル', '無料宿泊', 'ヒルトン', 'プリンスホテル']
  },
  'platinum-card': { 
    name: 'プラチナカード', 
    slug: 'platinum-card',
    keywords: ['プラチナカード', 'プラチナ', 'Platinum']
  },
  'gold-card': { 
    name: 'ゴールドカード', 
    slug: 'gold-card',
    keywords: ['ゴールドカード', 'ゴールド', 'Gold']
  },
  'priority-pass': { 
    name: 'プライオリティパス', 
    slug: 'priority-pass',
    keywords: ['プライオリティパス', 'Priority Pass', '空港ラウンジ']
  },
  'annual-fee-free': { 
    name: '年会費無料カード', 
    slug: 'annual-fee-free',
    keywords: ['年会費無料', '年会費', '無料']
  },
};

// タグとタイトルからカテゴリを判定
let primaryCategory = null;
const tagsAndTitle = [...tags, title].join(' ');

for (const [key, category] of Object.entries(categoryMap)) {
  if (category.keywords.some(kw => tagsAndTitle.includes(kw))) {
    primaryCategory = category;
    break;
  }
}

// カテゴリがない場合はデフォルト
if (!primaryCategory) {
  primaryCategory = { name: 'クレジットカード比較', slug: 'cards', keywords: [] };
}

// パンくずリスト用のJSON-LD（カテゴリを含む4階層）
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'ホーム',
      item: new URL('/', Astro.site).toString(),
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'クレジットカード比較',
      item: new URL('/articles', Astro.site).toString(),
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: primaryCategory.name,
      item: new URL(`/articles?tag=${encodeURIComponent(primaryCategory.slug)}`, Astro.site).toString(),
    },
    {
      '@type': 'ListItem',
      position: 4,
      name: title,
      item: new URL(Astro.url.pathname, Astro.site).toString(),
    },
  ],
};

// Article構造化データ
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  image: new URL('/images/og-default.jpg', Astro.site).toString(),
  datePublished: pubDate.toISOString(),
  dateModified: updatedDate?.toISOString() || pubDate.toISOString(),
  author: {
    '@type': 'Organization',
    name: author,
  },
  publisher: {
    '@type': 'Organization',
    name: 'クレジットカード比較',
    logo: {
      '@type': 'ImageObject',
      url: new URL('/images/logo.png', Astro.site).toString(),
    },
  },
};
---

<BaseLayout title={title} description={description}>
  <!-- 構造化データ -->
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />

  <!-- Breadcrumb -->
  <div class="bg-white border-b border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-2.5">
      <nav class="flex items-center gap-2 text-xs text-gray-400" aria-label="パンくずリスト">
        <a href="/" class="hover:text-primary-600">ホーム</a><span>›</span>
        <a href="/articles" class="hover:text-primary-600">クレジットカード比較</a><span>›</span>
        <a href={`/articles?tag=${encodeURIComponent(primaryCategory.slug)}`} class="hover:text-primary-600">{primaryCategory.name}</a><span>›</span>
        <span class="text-gray-600">{title}</span>
      </nav>
    </div>
  </div>

  <article class="bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">

    <!-- ヒーロー画像 -->
    {heroImage && (
      <div class="relative w-full h-64 md:h-80 mb-8 rounded-xl overflow-hidden shadow-2xl">
        <img 
          src={heroImage} 
          alt={title}
          class="w-full h-full object-cover"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/40 to-transparent flex items-end">
          <div class="p-4 md:p-6 lg:p-8 w-full">
            <h1 class="text-xl md:text-2xl lg:text-3xl font-black text-white mb-2 drop-shadow-lg leading-tight line-clamp-3">
              {title}
            </h1>
            <p class="text-sm md:text-base text-white/90 drop-shadow-md line-clamp-2 leading-relaxed">
              {description}
            </p>
          </div>
        </div>
      </div>
    )}

    <!-- 記事ヘッダー -->
    <header class="mb-8">
      {!heroImage && (
        <>
          <h1 class="text-3xl lg:text-4xl font-black text-gray-900 mb-4 leading-tight">{title}</h1>
          <p class="text-lg text-gray-600 mb-4 leading-relaxed">{description}</p>
        </>
      )}
      
      <div class="flex items-center gap-4 text-sm text-gray-500">
        <time datetime={pubDate.toISOString()}>📅 公開: {formattedPubDate}</time>
        {updatedDate && (
          <>
            <span>•</span>
            <time datetime={updatedDate.toISOString()}>🔄 更新: {formattedUpdatedDate}</time>
          </>
        )}
        <span>•</span>
        <span>✍️ {author}</span>
      </div>

      {tags.length > 0 && (
        <div class="flex flex-wrap gap-2 mt-4">
          {tags.map((tag) => (
            <span class="bg-primary-50 text-primary-700 px-3 py-1 rounded-full text-sm font-medium">
              #{tag}
            </span>
          ))}
        </div>
      )}
    </header>

    <!-- 記事本文 -->
    <div class="prose prose-lg max-w-none 
      prose-headings:font-black prose-headings:leading-tight
      prose-h1:text-3xl prose-h1:text-primary-900 prose-h1:mb-6
      prose-h2:text-2xl prose-h2:mt-12 prose-h2:mb-6 prose-h2:text-primary-900 prose-h2:bg-primary-50 prose-h2:border-l-4 prose-h2:border-primary-600 prose-h2:pl-4 prose-h2:py-3 prose-h2:rounded-r
      prose-h3:text-xl prose-h3:mt-8 prose-h3:mb-4 prose-h3:text-primary-800 prose-h3:pb-2 prose-h3:border-b-2 prose-h3:border-primary-200
      prose-h4:text-lg prose-h4:mt-6 prose-h4:mb-3 prose-h4:text-primary-700 prose-h4:font-bold
      prose-h5:text-base prose-h5:mt-4 prose-h5:mb-2 prose-h5:text-gray-800 prose-h5:font-bold
      prose-h6:text-base prose-h6:mt-4 prose-h6:mb-2 prose-h6:text-gray-700 prose-h6:font-semibold
      prose-p:text-gray-700 prose-p:leading-relaxed prose-p:mb-6 prose-p:text-base
      prose-a:text-primary-600 prose-a:font-medium prose-a:no-underline hover:prose-a:underline hover:prose-a:text-primary-800
      prose-strong:text-gray-900 prose-strong:font-bold
      prose-em:text-gray-800 prose-em:italic
      prose-ul:list-disc prose-ul:pl-6 prose-ul:space-y-2 prose-ul:my-6
      prose-ol:list-decimal prose-ol:pl-6 prose-ol:space-y-2 prose-ol:my-6
      prose-li:text-gray-700 prose-li:leading-relaxed
      prose-blockquote:border-l-4 prose-blockquote:border-primary-300 prose-blockquote:bg-primary-50 prose-blockquote:px-6 prose-blockquote:py-4 prose-blockquote:my-8 prose-blockquote:rounded-r
      prose-code:bg-gray-100 prose-code:text-accent-600 prose-code:px-2 prose-code:py-1 prose-code:rounded prose-code:text-sm prose-code:font-mono
      prose-pre:bg-gray-900 prose-pre:text-gray-100 prose-pre:p-4 prose-pre:rounded-lg prose-pre:overflow-x-auto prose-pre:my-6
      prose-table:border-collapse prose-table:w-full prose-table:my-8 prose-table:border prose-table:border-gray-300
      prose-thead:bg-primary-900
      prose-th:text-white prose-th:p-3 prose-th:text-left prose-th:font-bold prose-th:text-sm prose-th:border prose-th:border-primary-800
      prose-td:border prose-td:border-gray-200 prose-td:p-3 prose-td:text-sm prose-td:bg-white
      prose-tr:even:bg-gray-50
      prose-img:rounded-lg prose-img:shadow-lg prose-img:my-8 prose-img:w-full
      prose-hr:border-gray-300 prose-hr:my-10">
      <slot />
    </div>

    <!-- 記事フッター -->
    <footer class="mt-16 pt-8 border-t border-gray-200">
      <div class="bg-primary-50 p-6 rounded-xl border border-primary-100">
        <h3 class="text-lg font-bold text-gray-900 mb-2 flex items-center gap-2">
          <i data-lucide="thumbs-up" class="w-5 h-5 text-primary-600"></i>
          この記事は役に立ちましたか？
        </h3>
        <p class="text-gray-700 mb-4 text-sm">クレジットカード選びに関するご質問やフィードバックをお待ちしています。</p>
        <div class="flex flex-wrap gap-3">
          <button class="bg-primary-700 text-white px-6 py-2.5 rounded-lg hover:bg-primary-800 font-bold text-sm btn-cta shadow-sm">
            👍 役に立った
          </button>
          <button class="bg-white border border-gray-300 text-gray-700 px-6 py-2.5 rounded-lg hover:bg-gray-50 font-medium text-sm">
            💬 もっと知りたい
          </button>
        </div>
      </div>
    </footer>
    </div>
  </article>

  <!-- 関連記事 -->
  {relatedArticles.length > 0 && (
    <section class="bg-white py-12 border-t border-gray-200">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center gap-3 mb-8">
          <div class="w-1 h-8 bg-primary-600 rounded-full"></div>
          <h2 class="text-xl lg:text-2xl font-black text-gray-900">関連<span class="text-primary-600">記事</span></h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {relatedArticles.map((relatedArticle) => (
            <a 
              href={`/articles/${relatedArticle.slug}`}
              class="block bg-white border border-gray-200 rounded-xl p-6 hover:shadow-lg transition-shadow card-hover"
            >
              <h3 class="text-base font-bold text-gray-900 mb-2 line-clamp-2 leading-tight">
                {relatedArticle.data.title}
              </h3>
              <p class="text-gray-600 text-sm mb-3 line-clamp-2 leading-relaxed">
                {relatedArticle.data.description}
              </p>
              <div class="flex gap-2 flex-wrap mb-3">
                {relatedArticle.data.tags.slice(0, 3).map((tag) => (
                  <span class="bg-primary-50 text-primary-700 px-2 py-1 rounded text-xs font-medium">
                    #{tag}
                  </span>
                ))}
              </div>
              <div class="text-primary-600 text-sm font-bold flex items-center gap-1">
                続きを読む
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- 記事一覧に戻るボタン -->
  <section class="bg-white py-8">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <a 
          href="/articles" 
          class="inline-flex items-center gap-2 bg-primary-700 text-white px-8 py-3 rounded-lg font-bold hover:bg-primary-800 transition shadow-md btn-cta"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          記事一覧に戻る
        </a>
      </div>
    </div>
  </section>

  <!-- Lazyload script for article images -->
  <script>
    // Add loading="lazy" to all images in article content
    document.addEventListener('DOMContentLoaded', () => {
      const articleImages = document.querySelectorAll('.prose img');
      articleImages.forEach((img) => {
        if (!img.hasAttribute('loading')) {
          img.setAttribute('loading', 'lazy');
        }
      });
    });
  </script>

</BaseLayout>
